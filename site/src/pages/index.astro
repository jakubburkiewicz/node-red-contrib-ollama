---
import '../styles/global.css';
import { configNodes, actionNodes } from '../data/nodes';
import { examples, toFlowJson } from '../data/examples';

const repoUrl = 'https://github.com/jakubburkiewicz/node-red-contrib-ollama';
const npmUrl = 'https://www.npmjs.com/package/node-red-contrib-ollama';
const flowsUrl = 'https://flows.nodered.org/node/node-red-contrib-ollama';
const sponsorUrl = 'https://github.com/sponsors/jakubburkiewicz';
const version = '0.6.2';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} sizes="any" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>node-red-contrib-ollama</title>
		<meta name="description" content="Add AI functionality to your Node-RED flows with a set of nodes for Ollama, local or in the cloud." />
		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				}
			})();
		</script>
		<!-- Cloudflare Web Analytics -->
		<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "dd85d5448c8d441a9b48c2eb32a68662"}'></script>
		<!-- End Cloudflare Web Analytics -->
	</head>
	<body>
		<button id="theme-toggle" class="theme-toggle" aria-label="Toggle color theme" type="button"></button>

		<section id="hero" style="padding-top: 64px;">
			<div class="wrap hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Node-RED plugin</p>
					<h1 style="font-size: clamp(2rem, 5vw, 3.2rem);">node-red-contrib-ollama</h1>
					<p style="font-size: 1.15rem; max-width: 56ch;">
						Add AI to your flows. A set of Node-RED nodes that wrap{' '}
						<a href="https://github.com/ollama/ollama-js" style="text-decoration: underline;">ollama.js</a>,
						so you can chat, generate, and embed with any model — local Ollama or Ollama Cloud — without hand-rolling the client calls yourself.
					</p>
					<div class="badges">
						<span class="badge">v{version}</span>
						<span class="badge">MIT license</span>
						<span class="badge">Node.js ≥ 18</span>
					</div>
					<div style="display: flex; gap: 12px; flex-wrap: wrap;">
						<a class="btn btn-primary" href={flowsUrl}>View on Node-RED Library</a>
						<a class="btn btn-secondary" href={repoUrl}>View on GitHub</a>
						<a class="btn btn-secondary" href={npmUrl}>View on npm</a>
					</div>
				</div>
				<img
					class="hero-logo"
					src={`${import.meta.env.BASE_URL}/assets/logo.png`}
					alt="node-red-contrib-ollama logo"
					width="230"
					height="230"
				/>
			</div>
		</section>

		<section id="what">
			<div class="wrap">
				<p class="eyebrow">What it is</p>
				<h2>Ollama, as flow-native nodes</h2>
				<p>
					Instead of calling the Ollama API from a Function node, drop in a config node for your server
					and wire up dedicated nodes for chat, generation, embeddings and model management. Every node
					mirrors an <code>ollama.js</code> client call, with per-call parameters resolvable from either
					the node's own configuration or an incoming <code>msg.payload</code> field.
				</p>
				<p>
					Works with a local Ollama install, or with <strong>Ollama Cloud</strong> using an API key —
					same nodes, same flows.
				</p>
			</div>
		</section>

		<section id="requirements">
			<div class="wrap">
				<p class="eyebrow">Requirements</p>
				<h2>Before you start</h2>
				<ul>
					<li>Node.js 18 or higher</li>
					<li><a href="https://nodered.org/docs/getting-started/">Node-RED</a> installed</li>
					<li>
						Either <a href="https://ollama.com/">Ollama</a> running locally (or reachable over the network),
						or an <a href="https://ollama.com/settings/keys">Ollama Cloud</a> API key
					</li>
				</ul>
			</div>
		</section>

		<section id="install">
			<div class="wrap">
				<p class="eyebrow">Installation</p>
				<h2>Two ways to install</h2>
				<div class="cols">
					<div>
						<h3 style="font-family: var(--font-mono); font-size: 1rem;">Node-RED editor</h3>
						<ol>
							<li>Menu → <em>Manage palette</em></li>
							<li>Go to the <em>Install</em> tab</li>
							<li>Search for <code>node-red-contrib-ollama</code></li>
							<li>Click <em>Install</em></li>
						</ol>
					</div>
					<div>
						<h3 style="font-family: var(--font-mono); font-size: 1rem;">Command line</h3>
						<p>From your Node-RED user directory:</p>
						<pre style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 16px; overflow-x: auto;"><code style="background: none; border: none; padding: 0;">npm install node-red-contrib-ollama</code></pre>
						<p>Restart Node-RED to load the new nodes.</p>
					</div>
				</div>
			</div>
		</section>

		<section id="config">
			<div class="wrap">
				<p class="eyebrow">Configuration</p>
				<h2>Point it at a server</h2>
				<p>Every action node connects through a shared <strong>Server</strong> config node.</p>
				<div class="cols">
					<div class="card">
						<h3>Local Ollama</h3>
						<p>Host: <code>localhost</code> (or your server's address)<br />Port: <code>11434</code></p>
					</div>
					<div class="card">
						<h3>Ollama Cloud</h3>
						<p>Check "Use Ollama Cloud" and paste an API key — host/port are set automatically.</p>
					</div>
				</div>
			</div>
		</section>

		<section id="nodes">
			<div class="wrap">
				<p class="eyebrow">Nodes</p>
				<h2>Config nodes</h2>
				<div class="grid">
					{configNodes.map((node) => (
						<div class="card">
							<h3>{node.name}</h3>
							<p>{node.summary}</p>
						</div>
					))}
				</div>

				<h2 style="margin-top: 40px;">Action nodes</h2>
				<div class="grid">
					{actionNodes.map((node) => (
						<div class="card">
							<h3>{node.name}</h3>
							<p>{node.summary}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="examples">
			<div class="wrap">
				<p class="eyebrow">Examples</p>
				<h2>Examples</h2>
				<p>
					Node-RED wires the logic — these nodes replace the <code>ollama.js</code> client calls
					you'd otherwise write by hand.
				</p>
				<div class="examples-list">
					{examples.map((example, i) => (
						<div class="example-card">
							<div class="example-head">
								<span class="badge">{example.node}</span>
								<h3 class="example-title">{example.title}</h3>
							</div>
							<p>{example.description}</p>
							<div
								class="flow-embed"
								data-flow-index={i}
								data-flow-w={example.viewBox.split(' ')[2]}
								data-flow-h={example.viewBox.split(' ')[3]}
							>
								<svg>
									<g class="flowGridlines"></g>
									<g class="containerGroup"></g>
									<g class="flowGroups"></g>
									<g class="flowWires"></g>
									<g class="flowNodes"></g>
								</svg>
							</div>
							<p class="flow-embed-hint">Scroll or pinch to zoom, drag to pan.</p>
							<details class="json-details">
								<summary>View flow JSON</summary>
								<div class="json-details-body">
									<button type="button" class="copy-json-btn" data-json-index={i}>Copy JSON</button>
									<pre><code>{JSON.stringify(toFlowJson(example.flow), null, 2)}</code></pre>
								</div>
							</details>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="support">
			<div class="wrap">
				<p class="eyebrow">Support the project</p>
				<h2>Like using it?</h2>
				<p>
					This is a free, open-source project maintained in spare time. If it's useful to you,
					a star or a sponsorship goes a long way.
				</p>
				<div style="display: flex; gap: 12px; flex-wrap: wrap;">
					<a class="btn btn-primary" href={sponsorUrl}>♥ Sponsor on GitHub</a>
					<a class="btn btn-secondary" href={repoUrl}>★ Star the repo</a>
				</div>
			</div>
		</section>

		<footer class="wrap">
			<p class="footer-links">
				<span>MIT licensed.</span>
				<span><a href={`${repoUrl}/issues`} style="text-decoration: underline;">Report an issue</a></span>
				<span><a href={repoUrl} style="text-decoration: underline;">Source on GitHub</a></span>
				<span>Made with ❤️ and 🤖 by <a href="https://burkiewicz.dev" style="text-decoration: underline;">Jakub Burkiewicz</a></span>
			</p>
		</footer>

		<script is:inline>
			(function () {
				var root = document.documentElement;
				var btn = document.getElementById('theme-toggle');
				var media = window.matchMedia('(prefers-color-scheme: dark)');

				function effectiveTheme() {
					var explicit = root.getAttribute('data-theme');
					if (explicit === 'light' || explicit === 'dark') return explicit;
					return media.matches ? 'dark' : 'light';
				}

				function render() {
					btn.textContent = effectiveTheme() === 'dark' ? '☀️' : '🌙';
				}

				btn.addEventListener('click', function () {
					var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
					root.setAttribute('data-theme', next);
					localStorage.setItem('theme', next);
					render();
				});

				media.addEventListener('change', function () {
					if (!root.getAttribute('data-theme')) render();
				});

				render();
			})();
		</script>

		<script is:inline>
			(function () {
				document.querySelectorAll('.copy-json-btn').forEach(function (btn) {
					btn.addEventListener('click', function () {
						var code = btn.parentElement.querySelector('pre code');
						var text = code ? code.textContent : '';
						var done = function () {
							var original = btn.textContent;
							btn.textContent = 'Copied!';
							setTimeout(function () { btn.textContent = original; }, 1500);
						};
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(text).then(done);
						} else {
							var ta = document.createElement('textarea');
							ta.value = text;
							ta.style.position = 'fixed';
							ta.style.opacity = '0';
							document.body.appendChild(ta);
							ta.select();
							document.execCommand('copy');
							document.body.removeChild(ta);
							done();
						}
					});
				});
			})();
		</script>

		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
		<script is:inline src={`${import.meta.env.BASE_URL}/vendor/flowviewer.js`}></script>

		<script define:vars={{ base: import.meta.env.BASE_URL, exampleFlows: examples.map((e) => e.flow) }}>
			(function () {
				function toFlowJson(nodes) {
					var tab = 'tab1';
					return [{ id: tab, type: 'tab', label: 'Flow 1', disabled: false, info: '', env: [] }].concat(
						nodes.map(function (n) {
							// Config nodes (no x/y — never drawn on canvas) stay global,
							// same as in a real exported flow; giving them a `z` made the
							// renderer try to draw them at NaN,NaN.
							if (n.x === undefined || n.y === undefined) return n;
							return Object.assign({ z: tab }, n);
						})
					);
				}

				function addPanZoom(el) {
					if (typeof d3 === 'undefined') return;

					var svgNode = el.querySelector('svg');
					var svg = d3.select(svgNode);
					// wrap the rendered content in a <g> so a single transform can pan/zoom it
					svg.html('<g>' + svg.html() + '</g>');
					var inner = svg.select('g');

					// The flow's content sits roughly in [0,0]..[flowW,flowH] — that's also
					// the extent the vendored renderer draws its background grid over, so we
					// keep panning within it (plus a small margin) rather than revealing the
					// grid-less area beyond it.
					var flowW = Number(el.dataset.flowW) || 1000;
					var flowH = Number(el.dataset.flowH) || 200;
					var margin = 40;

					var rect = svgNode.getBoundingClientRect();
					var containerW = rect.width || flowW;
					var containerH = rect.height || flowH;

					var fitScale = Math.max(0.4, Math.min(1, (containerW - margin) / flowW, (containerH - margin) / flowH));
					var initialX = (containerW - flowW * fitScale) / 2;
					var initialY = (containerH - flowH * fitScale) / 2;

					var zoom = d3.zoom()
						.scaleExtent([0.4, 2.5])
						.translateExtent([[-margin, -margin], [flowW + margin, flowH + margin]])
						.on('start', function () { svg.classed('dragging', true); })
						.on('zoom', function (event) { inner.attr('transform', event.transform); })
						.on('end', function () { svg.classed('dragging', false); });

					svg.call(zoom);
					svg.call(zoom.transform, d3.zoomIdentity.translate(initialX, initialY).scale(fitScale));
				}

				function init() {
					if (typeof renderFlow !== 'function' || typeof jQuery === 'undefined') return;

					// Teach the generic flow renderer the colour our own node types use in
					// the real editor (declared in each node's .html, so it's accurate).
					// We deliberately do NOT give them a fake in-node icon: the node .html
					// files reference an icon file ('ollama.png') that isn't actually
					// shipped in the package, so the real editor doesn't show one either —
					// faking it here would misrepresent how the node currently looks.
					var ollamaTypes = [
						'ollama-chat', 'ollama-generate', 'ollama-embed', 'ollama-list', 'ollama-show',
						'ollama-ps', 'ollama-pull', 'ollama-push', 'ollama-create', 'ollama-copy',
						'ollama-delete', 'ollama-abort',
					];
					ollamaTypes.forEach(function (type) {
						clrByType[type] = _hshClr('rgb(186 230 253)');
					});

					var logoUrl = base + '/assets/logo.png';
					var BADGE = 48;
					var BADGE_GAP = 18;
					var NODE_HALF_H = 15;

					document.querySelectorAll('.flow-embed').forEach(function (el) {
						var nodes = exampleFlows[Number(el.dataset.flowIndex)];
						var flow = toFlowJson(nodes);
						renderFlow('tab1', flow, jQuery(el.querySelector('svg')), {
							arrows: false,
							gridlines: true,
							zoom: false,
							images: true,
							linklines: false,
							dllink: false,
							labels: true,
						});

						// Mark which nodes come from the plugin by floating the plugin's
						// logo above them — not inside them, since that's not how they
						// actually render today.
						var flowNodesGroup = d3.select(el.querySelector('.flowNodes'));
						nodes.forEach(function (n) {
							if (ollamaTypes.indexOf(n.type) === -1) return;
							var cy = n.y - NODE_HALF_H - BADGE_GAP - BADGE / 2;
							flowNodesGroup.append('image')
								.attr('class', 'ollama-badge')
								.attr('href', logoUrl)
								.attr('x', n.x - BADGE / 2)
								.attr('y', cy - BADGE / 2)
								.attr('width', BADGE)
								.attr('height', BADGE);
						});

						addPanZoom(el);
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', init);
				} else {
					init();
				}
			})();
		</script>
	</body>
</html>
